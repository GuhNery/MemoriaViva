# Crie backend/.env localmente e preencha os valores REAIS. Nunca publique o arquivo.
# Neon > projeto my-first-project > Connect > banco memoria_viva_dev.
# Use de preferência a conexão pooled para a API local.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-POOLER.neon.tech/memoria_viva_dev?sslmode=require
# Crie um segredo aleatório longo (32 caracteres ou mais) e mantenha-o privado.
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_NO_MINIMO_32_CARACTERES
PORT=3001
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:19000
# Não habilitar PGSSL=true sem necessidade: a URL Neon já exige TLS com sslmode=require.
